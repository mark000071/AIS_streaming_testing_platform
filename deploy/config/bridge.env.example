# Copy to bridge.env and adjust for your deployment; pass with
# `docker compose --env-file deploy/config/bridge.env ...` or wire into
# docker-compose.yml's `env_file:` list. See docs/DEPLOYMENT.md §5.
AIS_DATA_MODE=bridge
AIS_HOST=0.0.0.0
AIS_PORT=8080
# Root of MCM_streaming's serving/runtime tree (mounted read-only into the
# container, e.g. as /model-runtime -- see deploy/docker-compose.yml).
AIS_MODEL_DATA_DIR=/model-runtime
AIS_MAX_VESSELS=200
